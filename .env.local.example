# Skopiuj ten plik jako .env.local (lokalnie) lub ustaw w Vercel Dashboard

# URL backendu — lokalnie: http://localhost:3001
# Railway: https://twoj-backend.railway.app (bez trailing slash!)
NEXT_PUBLIC_API_URL=https://twoj-backend.railway.app

# Socket.io URL — zazwyczaj ten sam co API
NEXT_PUBLIC_SOCKET_URL=https://twoj-backend.railway.app

# LiveKit Cloud WebSocket URL
# Znajdziesz w: cloud.livekit.io → projekt → Settings
NEXT_PUBLIC_LIVEKIT_URL=wss://twoj-projekt.livekit.cloud
