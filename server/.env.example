# ─── Baza danych ─────────────────────────────────────────────────────────────
# Railway automatycznie ustawia MYSQL_URL — nie musisz podawać poniższych
# Lokalnie użyj osobnych zmiennych:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexus

# ─── Serwer ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://twoja-aplikacja.vercel.app
# Dodatkowe dozwolone originy (przecinkami), np. preview deploys
ALLOWED_ORIGINS=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# WAŻNE: minimum 32 losowych znaków! Wygeneruj: openssl rand -hex 32
JWT_SECRET=zmien_na_losowy_dlugi_klucz_min_32_znaki
JWT_EXPIRES_IN=7d

# ─── Szyfrowanie sekretów 2FA (at-rest) ──────────────────────────────────────
# Klucz do szyfrowania sekretów TOTP w bazie (AES-256-GCM). Wygeneruj: openssl rand -hex 32
# UWAGA: nie zmieniaj po zaszyfrowaniu danych — inaczej sekrety 2FA staną się nieodczytywalne.
TOTP_ENC_KEY=

# ─── LiveKit ─────────────────────────────────────────────────────────────────
# Lokalnie: ws://localhost:7880
# LiveKit Cloud: wss://twoj-projekt.livekit.cloud
LIVEKIT_URL=wss://twoj-projekt.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Tenor GIF API ───────────────────────────────────────────────────────────
# Klucz do API Tenor (GIF wyszukiwarka). Utwórz na: https://developers.google.com/tenor
TENOR_API_KEY=
